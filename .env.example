# ---------- SERVER ----------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/resqroute?retryWrites=true&w=majority

# JWT secret for demo authentication (generate with: openssl rand -base64 32)
JWT_SECRET=replace_this_with_a_long_random_string

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- AI SERVICE (future real integration point) ----------
# Base URL of the Python AI/CV microservice. Not required for demo/simulation mode.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_ENABLED=false

# ---------- MAPS ----------
# Leaflet + OpenStreetMap requires no API key. If you later swap to Mapbox/Google Maps,
# put the key here and never hardcode it in client code.
MAP_PROVIDER=osm
